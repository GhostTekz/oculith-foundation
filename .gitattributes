# Binaire bestanden nooit door de regeleinde-normalisatie halen: git zou
# CRLF injecteren en het bestand daarmee stukmaken. Speelt onder meer bij de
# tekenkaders en onderhoeken (resources/kaders, resources/onderhoeken) en bij
# de meegeleverde binaries.
*.pdf      binary
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.ico      binary
*.icns     binary
*.woff     binary
*.woff2    binary
*.ttf      binary
*.otf      binary
*.dll      binary
*.exe      binary
*.so       binary
*.dylib    binary
*.zip      binary
*.apk      binary
*.dmg      binary
*.snap     binary
*.AppImage binary
*.dxf      binary
*.p12      binary
*.pfx      binary
*.der      binary
*.cer      binary
*.crt      binary
*.p7s      binary
*.bin      binary

# Shellscripts altijd met LF, ook bij core.autocrlf=true: bash weigert CRLF.
*.sh       text eol=lf

# Lockfiles with LF everywhere: the source bill of materials records their hashes.
Cargo.lock text eol=lf
open-pdf-studio/package-lock.json text eol=lf

# License and notice texts kept byte for byte: their SHA-256 hashes are
# pinned (package-notices.test.mjs, the source bill of materials), so no
# platform may change their line endings.
open-pdf-studio/src-tauri/package-notices/** -text
scripts/rust-upstream-notices/** -text
